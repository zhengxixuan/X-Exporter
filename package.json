{
  "name": "xbookmarkexporter-extension",
  "version": "0.1.0",
  "description": "X.com exporter extension with Markdown and poster output.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config .eslintrc.cjs \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ci": "vitest run --reporter=default",
    "smoke": "npm run lint && npm run typecheck && npm run test:ci"
  },
  "keywords": [
    "chrome-extension",
    "x-exporter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.27",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.5"
  }
}
